# Experimental Apptainer/Singularity training definition.
#
# A build node needs network access plus working Apptainer/Singularity:
#     apptainer build toolcall-lora.sif apptainer.def
#   (older Singularity:  singularity build toolcall-lora.sif apptainer.def)
#
# The resulting image includes dependencies, a downloaded model snapshot,
# llama.cpp, and synthetic data. A network-isolated compute run is conditional
# on local GPU/driver compatibility and prior review of artifacts and labels.
Bootstrap: docker
From: pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

%files
    requirements.txt   /workspace/requirements.txt
    train_lora.py      /workspace/train_lora.py
    download_assets.py /workspace/download_assets.py
    make_data.py       /workspace/make_data.py
    system_prompt.txt  /workspace/system_prompt.txt

%post
    apt-get update && apt-get install -y --no-install-recommends git && \
        rm -rf /var/lib/apt/lists/*
    cd /workspace
    pip install --no-cache-dir -r requirements.txt
    # Generate the experimental synthetic data, then fetch model + llama.cpp.
    mkdir -p data
    python make_data.py --out data/toolcall.jsonl
    python download_assets.py

%environment
    export LLAMACPP_DIR=/workspace/assets/llama.cpp
    export HF_HUB_OFFLINE=1
    export TRANSFORMERS_OFFLINE=1

# `apptainer run --nv toolcall-lora.sif --to-gguf` attempts training and
# conversion; arguments pass through.
%runscript
    cd /workspace
    exec python train_lora.py "$@"
